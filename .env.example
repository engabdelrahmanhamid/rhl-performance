# قاعدة البيانات — Supabase Postgres (خارجية مُدارة، لا قاعدة محلية في الإنتاج)
# DATABASE_URL: "Transaction" pooler (المنفذ 6543) + ?pgbouncer=true&connection_limit=5 إلزاميًا.
#   تحذير مُثبَت فعليًا بالتجربة: Session pooler (المنفذ 5432) محدود بـ15 اتصالًا متزامنًا فقط
#   على مستوى المشروع كله (EMAXCONNSESSION) - يكفيها عملية واحدة لتقفل الموقع بالكامل. لا تستخدمه
#   أبدًا لـDATABASE_URL - Transaction pooler فقط للتشغيل الفعلي.
# DIRECT_URL: "Session pooler" (المنفذ 5432) — يُستخدم فقط وقت "npx prisma migrate deploy" (نادر، عملية واحدة في كل مرة).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# رفع الملفات
UPLOADS_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# تصدير PDF — انظر src/lib/services/pdfExport.ts للتفاصيل الكاملة
# playwright (افتراضي، للتطوير المحلي) أو browserless (لبيئة استضافة مُدارة بلا Chromium)
PDF_ENGINE="playwright"
# مطلوب فقط عند PDF_ENGINE=browserless — من https://www.browserless.io بعد إنشاء حساب
BROWSERLESS_API_KEY=""

# SMTP (اختياري - غير مفعّل في V1، اتركه فارغًا حتى تزويد المكتب ببيانات فعلية)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

TZ="Asia/Riyadh"
