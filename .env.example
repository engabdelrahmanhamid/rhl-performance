# قاعدة البيانات — Supabase Postgres (خارجية مُدارة، لا قاعدة محلية في الإنتاج)
# DATABASE_URL: من Supabase → Project Settings → Database → Connection string → "Transaction" pooler (المنفذ 6543)، أضف ?pgbouncer=true في النهاية.
# DIRECT_URL: نفس الصفحة → "Session"/"Direct connection" (المنفذ 5432) — تُستخدم فقط وقت "npx prisma migrate deploy".
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# رفع الملفات
UPLOADS_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10

# تصدير PDF — انظر src/lib/services/pdfExport.ts للتفاصيل الكاملة
# playwright (افتراضي، للتطوير المحلي) أو browserless (لبيئة استضافة مُدارة بلا Chromium)
PDF_ENGINE="playwright"
# مطلوب فقط عند PDF_ENGINE=browserless — من https://www.browserless.io بعد إنشاء حساب
BROWSERLESS_API_KEY=""

# SMTP (اختياري - غير مفعّل في V1، اتركه فارغًا حتى تزويد المكتب ببيانات فعلية)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

TZ="Asia/Riyadh"
